<?php
/**
 * Product list template
 *
 * @var $block \Magento\Catalog\Block\Product\ListProduct
 * @var \Magento\Framework\Escaper $escaper
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */

$ajaxUrl      = $block->getAjaxUrl();
$placementId  = $block->getData('placement-id');
$eventType    = $block->getData('event-type');
$customerId   = $block->getUserEventId();
$productId    = $block->getProductPageId();
$cacheKey     = $block->getRecommendationCacheKey();
?>
<script type="text/x-magento-init">
{
    "[data-role=google-recommendation]": {
            "Magento_Ui/js/core/app": {
                    "components": {
                        "recommendation": {
                            "component": "RetailAI_Recommendations/js/view/recommendation",
                            "ajaxUrl": "<?= $escaper->escapeUrl($ajaxUrl); ?>",
                            "placementId": "<?= $escaper->escapeHtml($placementId); ?>",
                            "eventType": "<?= $escaper->escapeHtml($eventType); ?>",
                            "recCacheKey": "<?= $escaper->escapeHtml($cacheKey); ?>",
                            "productId": "<?= $escaper->escapeHtml($productId); ?>"
                        }
                    }
                }
            }
}
</script>
<?php if ($block->getTitle()): ?>
    <p class="google-logo">
        <strong><?= $block->escapeHtml(__($block->getTitle())) ?></strong>
    </p>
<?php endif ?>
<div id="google_recs" data-bind="scope: 'recommendation'" data-role="google-recommendation"></div>

